{
  "manifest_version": 3,
  "name": "Too Many Leagues Connector",
  "version": "0.1.0",
  "description": "Connect your ESPN and Yahoo fantasy leagues to Too Many Leagues.",
  "permissions": ["cookies"],
  "host_permissions": ["https://*.espn.com/*", "https://*.yahoo.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": [
      "https://toomanyleagues.alddimeo.workers.dev/*",
      "http://localhost:3000/*",
      "http://127.0.0.1:3000/*"
    ],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
